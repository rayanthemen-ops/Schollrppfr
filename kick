-- DURÉE
-- ═══════════════════════════════════════════════════
local function getDur()
    if isPermanent then return -1,"Permanent" end
    local d=tonumber(dBox.Text) or 0
    local h=tonumber(hBox.Text) or 0
    local m=tonumber(mBox.Text) or 0
    local s=(d*86400)+(h*3600)+(m*60)
    if s==0 then return 0,"Permanent (0=perm)" end
    return s,(d>0 and d.."j " or "")..(h>0 and h.."h " or "")..(m>0 and m.."min" or "")
end

