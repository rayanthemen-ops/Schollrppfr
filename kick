-- ═══════════════════════════════════════════════════
-- ACTION BAN / KICK — REMOTES UNIQUEMENT (jamais self-kick)
-- ═══════════════════════════════════════════════════
local function execAction(action)
    -- Protection : jamais se cibler soi-même
    if not selectedPlayer then
        notif("⚠️ Sélectionne un joueur !", Color3.fromRGB(255,180,0)); return
    end
    if selectedPlayer == LocalPlayer then
        notif("⛔ Tu ne peux pas te cibler toi-même !", Color3.fromRGB(255,60,60)); return
    end
    -- Vérifier que le joueur est toujours en jeu
    if not Players:FindFirstChild(selectedPlayer.Name) then
        notif("❌ Ce joueur a quitté le jeu", Color3.fromRGB(255,80,80)); return
    end

    local target = selectedPlayer
    local tName  = target.Name
    local tId    = target.UserId
    local reason = rsnBox.Text ~= "" and rsnBox.Text or
        (action=="ban" and "Banni par l'admin" or "Expulsé par l'admin")
    local durSec, durTxt = getDur()
    local success = 0

    print("["..action:upper().."] ▶ "..tName.." | "..reason.." | "..durTxt)

    -- ── M1 : Serveur SF ──────────────────────────────
    if SR.sfServer then
        if action=="kick" and SR.sfKick then
            pcall(function() SR.sfKick:FireServer(tName, reason); success+=1 end)
            print("[M1] SF Kick envoyé")
        elseif action=="ban" and SR.sfBan then
            local d=durSec==-1 and 0 or durSec
            pcall(function() SR.sfBan:FireServer(tName, reason, d); success+=1 end)
            print("[M1] SF Ban envoyé | "..durTxt)
        end
    end

    -- ── M2 : Commandes chat système admin ────────────
    if SR.chatBased then
        for _,pfx in ipairs(SR.chatPrefixes) do
            if action=="kick" then
                chat(pfx.."kick "..tName.." "..reason)
                chat(pfx.."k "..tName)
            elseif action=="ban" then
                if durSec<=0 or durSec==-1 then
                    chat(pfx.."ban "..tName.." "..reason)
                    chat(pfx.."permban "..tName.." "..reason)
                    chat(pfx.."pban "..tName.." "..reason)
                else
                    local days=math.max(1,math.floor(durSec/86400))
                    chat(pfx.."tempban "..tName.." "..days.." "..reason)
                    chat(pfx.."tban "..tName.." "..days.." "..reason)
                    chat(pfx.."ban "..tName.." "..days.." "..reason)
                end
            end
        end
        success+=1; print("[M2] Chat commands envoyées via "..tostring(SR.adminSystem))
    end

    -- ── M3 : Remotes spécifiques (ban/kick) ──────────
    local targets = action=="ban" and SR.banR or SR.kickR
    for _,r in ipairs(targets) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                r:FireServer(target, reason)
                r:FireServer(tName,  reason)
                r:FireServer(tId,    reason)
                r:FireServer({player=target, name=tName, userId=tId, reason=reason, action=action})
                r:FireServer(action, target, reason)
                if action=="ban" then
                    r:FireServer(target, reason, durSec, isPermanent)
                    r:FireServer({player=target, reason=reason, duration=durSec, permanent=isPermanent})
                end
                success+=1
            elseif r:IsA("RemoteFunction") then
                r:InvokeServer(target, reason); success+=1
            elseif r:IsA("BindableEvent") then
                r:Fire(target, reason); success+=1
            end
        end)
    end
    print("[M3] "..#targets.." remotes "..action.." ciblés")

    -- ── M4 : Remotes staff avec action ───────────────
    for _,r in ipairs(SR.staffR) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                r:FireServer(action, target, reason)
                r:FireServer(action, tName,  reason)
                r:FireServer({action=action, target=target, reason=reason, duration=durSec})
                if action=="ban" then
                    r:FireServer("ban", target, reason, durSec, isPermanent)
                end
                success+=1
            end
        end)
    end
    print("[M4] "..#SR.staffR.." remotes staff ciblés")

    -- ── M5 : Toutes les remotes (brute force propre) ──
    -- IMPORTANT : on envoie seulement l'action + target, jamais Kick() direct
    local brute=0
    for _,r in ipairs(SR.allR) do
        if r:IsA("RemoteEvent") then
            pcall(function()
                r:FireServer(action, target, reason)
                r:FireServer(target, action, reason)
                brute+=1
            end)
        end
    end
    print("[M5] Brute force "..brute.." remotes")

    local col=success>0 and Color3.fromRGB(80,255,120) or Color3.fromRGB(255,155,40)
    local ico=action=="ban" and "🔨" or "👢"
    local msg=ico.." "..action:upper().." : "..tName..(action=="ban" and " | "..durTxt or "").." | "..success.." succès"
    logTxt.Text=msg; logTxt.TextColor3=col
    notif(msg, col)
    print("["..action:upper().."] Terminé — "..success.." succès")
end

