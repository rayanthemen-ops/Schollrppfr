local function notif(msg, col)
    col = col or Color3.fromRGB(100,200,100)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0,320,0,54)
    f.Position = UDim2.new(0.5,-160,1,-78)
    f.BackgroundColor3 = Color3.fromRGB(11,11,17)
    f.ZIndex = 30; f.Parent = ScreenGui
    Instance.new("UICorner",f).CornerRadius = UDim.new(0,9)
    local s=Instance.new("UIStroke",f); s.Thickness=1.5; s.Color=col
    local l=Instance.new("TextLabel",f)
    l.Size=UDim2.new(1,-12,1,0); l.Position=UDim2.new(0,6,0,0)
    l.BackgroundTransparency=1; l.Text=msg; l.TextColor3=col
    l.Font=Enum.Font.GothamBold; l.TextSize=10; l.TextWrapped=true; l.ZIndex=31
    TweenService:Create(f,TweenInfo.new(0.25,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
        {Position=UDim2.new(0.5,-160,1,-148)}):Play()
    task.delay(3.5,function()
        local t=TweenService:Create(f,TweenInfo.new(0.25,Enum.EasingStyle.Quart,Enum.EasingDirection.In),
            {Position=UDim2.new(0.5,-160,1,-78)})
        t:Play(); t.Completed:Connect(function() f:Destroy() end)
    end)
end

