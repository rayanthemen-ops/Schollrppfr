local function addHover(btn, normalBg, hoverBg)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = hoverBg}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = normalBg}):Play()
    end)
end

-- Création de cartes
local function mkCard(parent, pos, sz, bg)
    local f = Instance.new("Frame", parent)
    f.Position = pos
    f.Size = sz
    f.BackgroundColor3 = bg or Color3.fromRGB(20, 22, 30)
    f.BorderSizePixel = 0
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    
    local str = Instance.new("UIStroke", f)
    str.Thickness = 1
    str.Color = Color3.fromRGB(35, 38, 52)
    str.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return f
end

-- Generateur de Labels
local function mkL(p, pos, sz, txt, fs, col, font, xa)
    local l = Instance.new("TextLabel", p)
    l.Size = sz; l.Position = pos
    l.BackgroundTransparency = 1
    l.Text = txt
    l.TextColor3 = col or Color3.fromRGB(215, 218, 230)
    l.Font = font or Enum.Font.GothamMedium
    l.TextSize = fs or 11
    l.TextXAlignment = xa or Enum.TextXAlignment.Center
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextWrapped = true
    return l
end

-- Generateur de Boutons
local function mkB(p, pos, sz, txt, bg, fs)
    local b = Instance.new("TextButton", p)
    b.Size = sz; b.Position = pos
    b.BackgroundColor3 = bg
    b.Text = txt
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = fs or 10
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    local hoverCol = Color3.fromRGB(
        math.min(255, bg.R * 255 + 20),
        math.min(255, bg.G * 255 + 20),
        math.min(255, bg.B * 255 + 20)
    )
    addHover(b, bg, hoverCol)
    return b
end

