-- FREE CAM
-- ═══════════════════════════════════════════════════
local fcA=false; local fcC=nil; local ks={}

local function enableFC()
    fcA=true; ks={}; Camera.CameraType=Enum.CameraType.Scriptable
    fcC=RunService.RenderStepped:Connect(function(dt)
        if not fcA then return end
        local mv=Vector3.new(0,0,0)
        if ks[Enum.KeyCode.W] then mv+=Camera.CFrame.LookVector end
        if ks[Enum.KeyCode.S] then mv-=Camera.CFrame.LookVector end
        if ks[Enum.KeyCode.A] then mv-=Camera.CFrame.RightVector end
        if ks[Enum.KeyCode.D] then mv+=Camera.CFrame.RightVector end
        if ks[Enum.KeyCode.Space] then mv+=Vector3.new(0,1,0) end
        if ks[Enum.KeyCode.LeftShift] then mv-=Vector3.new(0,1,0) end
        if mv.Magnitude>0 then Camera.CFrame=Camera.CFrame+(mv.Unit*FREE_CAM_SPEED*dt) end
    end)
    fcBtn.Text="📷 FREE CAM (ON)"; fcBtn.BackgroundColor3=Color3.fromRGB(22,175,60)
    notif("📷 Free Cam ON — WASD/SPACE/SHIFT",Color3.fromRGB(80,200,255))
end

local function disableFC()
    fcA=false; if fcC then fcC:Disconnect(); fcC=nil end; ks={}
    Camera.CameraType=Enum.CameraType.Custom
    fcBtn.Text="📷 FREE CAM (OFF)"; fcBtn.BackgroundColor3=Color3.fromRGB(32,105,175)
    notif("📷 Free Cam OFF",Color3.fromRGB(120,120,135))
end

UserInputService.InputBegan:Connect(function(i) ks[i.KeyCode]=true end)
UserInputService.InputEnded:Connect(function(i) ks[i.KeyCode]=false end)
