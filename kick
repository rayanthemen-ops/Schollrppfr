local function deepScan()
    scanBtn.Text="⏳ Scan..."
    scanBtn.BackgroundColor3=Color3.fromRGB(35,35,50)
    ALL_REMOTES={}
    SR={
        adminSystem=nil, chatPrefixes={}, chatBased=false,
        banR={}, kickR={}, staffR={}, grantR={}, allR={},
        sfServer=false, sfKick=nil, sfBan=nil,
    }

    print("══════ SF DEEP SCAN v30 ══════")

    -- Systèmes connus
    local systems={
        {name="Kohl's Admin",  prefixes={":",  "!"},  check=function() return ReplicatedStorage:FindFirstChild("KAEd") or LocalPlayer.PlayerGui:FindFirstChild("KAInterface") end},
        {name="HD Admin",      prefixes={"/",  ":"},  check=function() return ReplicatedStorage:FindFirstChild("HDAdminClient") or ReplicatedStorage:FindFirstChild("HDAdmin") end},
        {name="Adonis Admin",  prefixes={":",  ";"},  check=function() return ReplicatedStorage:FindFirstChild("Adonis") or ReplicatedStorage:FindFirstChild("AdonisLoader") end},
        {name="Voxel Security",prefixes={":"},        check=function() return ReplicatedStorage:FindFirstChild("VoxelSecurity") end},
        {name="Cmdr",          prefixes={"/"},        check=function() return ReplicatedStorage:FindFirstChild("CmdrClient") or ReplicatedStorage:FindFirstChild("Cmdr") end},
        {name="Benet Admin",   prefixes={"!"},        check=function() return ReplicatedStorage:FindFirstChild("Benet") or ReplicatedStorage:FindFirstChild("BenetAdmin") end},
        {name="Penzle Admin",  prefixes={":"},        check=function() return ReplicatedStorage:FindFirstChild("Penzle") end},
        {name="Roactstrap",    prefixes={":"},        check=function() return game:GetService("ServerStorage") and game:GetService("ServerStorage"):FindFirstChild("AdminScript") end},
    }

    for _,sys in ipairs(systems) do
        local ok,r=pcall(sys.check)
        if ok and r then
            SR.adminSystem=sys.name; SR.chatPrefixes=sys.prefixes; SR.chatBased=true
            print("[ADMIN] Détecté : "..sys.name); break
        end
    end

    -- Classification remotes
    local banKW   = {"ban","blacklist","block","restrict","suspend","permban","tempban"}
    local kickKW  = {"kick","remove","eject","expel","boot"}
    local staffKW = {"admin","staff","mod","moderator","command","punish","action","execute",
                     "manage","control","auth","permission","rank","role","privilege"}
    local grantKW = {"addadmin","giveadmin","setrank","addstaff","whitelist","grant","promote",
                     "setadmin","makeadmin","setrole","giverole","addrank","addrole"}

    local function classify(name)
        local n=name:lower()
        for _,k in ipairs(grantKW)  do if n:find(k) then return "grant" end end
        for _,k in ipairs(banKW)    do if n:find(k) then return "ban"   end end
        for _,k in ipairs(kickKW)   do if n:find(k) then return "kick"  end end
        for _,k in ipairs(staffKW)  do if n:find(k) then return "staff" end end
        return "other"
    end

    for _,obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent") then
            table.insert(ALL_REMOTES,obj); table.insert(SR.allR,obj)
            local cat=classify(obj.Name)
            if cat=="grant" then table.insert(SR.grantR,obj) end
            if cat=="ban"   then table.insert(SR.banR,  obj) end
            if cat=="kick"  then table.insert(SR.kickR, obj) end
            if cat=="staff" then table.insert(SR.staffR,obj) end
            if cat~="other" then print("[REMOTE]["..cat:upper().."] "..obj:GetFullName()) end
        end
    end

    -- Serveur SF
    local sfF=ReplicatedStorage:FindFirstChild("SF_AdminRemotes")
    if sfF then
        local kr=sfF:FindFirstChild("SF_Kick"); local br=sfF:FindFirstChild("SF_Ban")
        if kr and br then SR.sfServer=true; SR.sfKick=kr; SR.sfBan=br; print("[SF] ✅ Serveur SF détecté") end
    end

    local sys=SR.adminSystem or "Custom"
    rptTxt.Text=string.format("✅ %d remotes  🔨%d 👢%d 🛠%d 🔑%d  | %s%s",
        #SR.allR,#SR.banR,#SR.kickR,#SR.staffR,#SR.grantR,sys,SR.sfServer and " +SF" or "")
    rptTxt.TextColor3=Color3.fromRGB(90,220,120)

    local col=SR.sfServer and Color3.fromRGB(14,145,85) or Color3.fromRGB(85,45,190)
    bnrF.BackgroundColor3=col
    bnrTxt.Text="🔬 "..sys..(SR.sfServer and " + Serveur SF ✅" or "").." — "..#SR.allR.." remotes"
    logTxt.Text="✅ Scan OK — Clique AUTO WHITELIST pour te donner l'accès"
    logTxt.TextColor3=Color3.fromRGB(90,220,120)
    scanBtn.Text="✅ "..(#SR.allR).." remotes"
    scanBtn.BackgroundColor3=Color3.fromRGB(22,100,50)
    notif("🔬 Scan OK — "..#SR.allR.." remotes | "..sys,Color3.fromRGB(80,200,255))
    print("══════ SCAN TERMINÉ ══════")
end

-- ═══════════════════════════════════════════════════
-- AUTO WHITELIST — SE DONNER L'ACCÈS STAFF
-- ═══════════════════════════════════════════════════
local function autoWhitelist()
    wlBtn.Text="⏳ Whitelist..."
    wlBtn.BackgroundColor3=Color3.fromRGB(35,35,50)
    local me=LocalPlayer
    local success=0

    print("══════ AUTO WHITELIST ══════")

    -- 1. Valeurs locales
    pcall(function()
        local vals={
            {"Role","StringValue","Admin"},{"IsStaff","BoolValue",true},
            {"IsAdmin","BoolValue",true},{"Rank","StringValue","Admin"},
            {"CanBan","BoolValue",true},{"CanKick","BoolValue",true},
            {"AdminLevel","NumberValue",5},{"StaffLevel","NumberValue",5},
            {"Permission","NumberValue",255},{"AccessLevel","NumberValue",5},
        }
        for _,v in ipairs(vals) do
            local e=me:FindFirstChild(v[1]) or Instance.new(v[2],me)
            e.Name=v[1]; e.Value=v[3]
        end
        success+=1; print("[WL-1] Valeurs locales injectées")
    end)

    -- 2. Remotes de grant explicites
    for _,r in ipairs(SR.grantR) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                r:FireServer(me, "Admin", 5, true)
                r:FireServer(me.Name, "Admin", 5, true)
                r:FireServer(me.UserId, "Admin", 5)
                r:FireServer({player=me, role="Admin", rank=5, admin=true})
                success+=1; print("[WL-2] Grant remote: "..r:GetFullName())
            elseif r:IsA("RemoteFunction") then
                r:InvokeServer(me, "Admin")
                success+=1
            end
        end)
    end

    -- 3. Remotes staff/auth/rank avec moi comme cible
    for _,r in ipairs(SR.staffR) do
        local n=r.Name:lower()
        if n:find("auth") or n:find("rank") or n:find("role") or n:find("perm") or n:find("add") then
            pcall(function()
                if r:IsA("RemoteEvent") then
                    r:FireServer(me, "Admin", 5, true)
                    r:FireServer("Admin", true, me.UserId, 5)
                    r:FireServer({player=me, admin=true, role="Admin", rank=5})
                    success+=1; print("[WL-3] Staff remote: "..r:GetFullName())
                end
            end)
        end
    end

    -- 4. Commandes chat spécifiques au système détecté
    if SR.chatBased and SR.adminSystem then
        local cmds={}
        if SR.adminSystem:find("Kohl") then
            cmds={":adm "..me.Name, ":admin "..me.Name, "!adm "..me.Name}
        elseif SR.adminSystem:find("HD Admin") then
            cmds={"/setrank "..me.Name.." 255", "/admin "..me.Name}
        elseif SR.adminSystem:find("Adonis") then
            cmds={":sm "..me.Name.." superadmin", ":admin "..me.Name}
        elseif SR.adminSystem:find("Cmdr") then
            cmds={"/rank "..me.Name.." admin"}
        end
        for _,cmd in ipairs(cmds) do
            pcall(function()
                -- Nouvelle API chat
                local chs=TextChatService:FindFirstChild("TextChannels")
                if chs then
                    local g=chs:FindFirstChild("RBXGeneral")
                    if g then g:SendAsync(cmd) end
                end
                success+=1; print("[WL-4-CHAT] "..cmd)
            end)
        end
    end

    -- 5. Serveur SF
    if SR.sfServer then
        success+=1; print("[WL-5] Serveur SF présent — accès garanti")
    end

    -- 6. Toutes les remotes qui contiennent le mot "add" ou "give" ou "set" avec admin/staff
    for _,r in ipairs(SR.allR) do
        local n=r.Name:lower()
        if (n:find("add") or n:find("give") or n:find("set") or n:find("make")) and
           (n:find("admin") or n:find("staff") or n:find("rank") or n:find("mod")) then
            pcall(function()
                if r:IsA("RemoteEvent") then
                    r:FireServer(me, "Admin")
                    r:FireServer(me.Name, "Admin")
                    r:FireServer({target=me, rank="Admin", level=5})
                    success+=1; print("[WL-6] "..r:GetFullName())
                end
            end)
        end
    end

    WHITELISTED = success > 0
    local col = WHITELISTED and Color3.fromRGB(34,200,94) or Color3.fromRGB(255,160,40)
    wlTxt.Text = WHITELISTED and
        ("✅ Whitelist activée — "..success.." méthodes") or
        "⚠️ Whitelist partielle (installe le serveur SF)"
    wlTxt.TextColor3 = col

    wlBtn.Text="⚡ AUTO WHITELIST"
    wlBtn.BackgroundColor3=WHITELISTED and Color3.fromRGB(20,130,60) or Color3.fromRGB(140,60,20)
    bnrF.BackgroundColor3=WHITELISTED and Color3.fromRGB(14,145,85) or Color3.fromRGB(130,70,20)
    bnrTxt.Text=(WHITELISTED and "👑 Staff activé — " or "⚠️ Partiel — ")..me.Name
    logTxt.Text="⚡ Whitelist: "..success.." méthodes OK — Sélectionne un joueur → BAN/KICK"
    logTxt.TextColor3=col
    notif("⚡ Auto-whitelist: "..success.." méthodes activées",col)
    print("══════ WHITELIST TERMINÉE — "..success.." succès ══════")
end

