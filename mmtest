					end
					humanoid.PlatformStand = false
					task.wait(0.5)
				else
					if waitingForNewRound then
						waitingForNewRound = false
						autofarmBtn.Text = L("AutoFarmCoins") .. "ON"
						autofarmBtn.TextColor3 = Color3.fromRGB(80, 255, 80)
					end
					
					local coin = findNearestValidCoin()
					if coin and coin.Parent and coin.Transparency < 1 then
						humanoid.PlatformStand = true
						
						while autoFarmEnabled and coin and coin.Parent and coin.Transparency < 1 do
							local targetCF = coin.CFrame + Vector3.new(0, 0.1, 0)
							local distance = (rootPart.Position - targetCF.Position).Magnitude
							
							if distance < 0.4 then break end 
							
							local dt = RunService.RenderStepped:Wait()
							local currentPos = rootPart.Position
							local alpha = math.clamp((autoFarmSpeed * dt) / math.max(distance, 0.1), 0, 1)
							local nextPos = currentPos:Lerp(targetCF.Position, alpha)
							
							rootPart.CFrame = CFrame.new(nextPos, nextPos + Camera.CFrame.LookVector * Vector3.new(1, 0, 1))
							rootPart.AssemblyLinearVelocity = Vector3.zero
							rootPart.AssemblyAngularVelocity = Vector3.zero
						end
						
						if coin and coin.Parent then
							rootPart.CFrame = coin.CFrame + Vector3.new(0, 0.1, 0)
						end
						
						rootPart.AssemblyLinearVelocity = Vector3.zero
						rootPart.AssemblyAngularVelocity = Vector3.zero
						
						task.wait(0.05)
						humanoid.PlatformStand = false
					else
						humanoid.PlatformStand = false
						task.wait(0.1)
					end
				end
			else
				task.wait(0.5)
			end
		else
			task.wait(0.2)
		end
	end
end)

local function findPlayerByRole(targetRole)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local char = plr.Character
			local function checkContainer(container)
				if not container then return false end
				for _, item in ipairs(container:GetChildren()) do
					if item:IsA("Tool") then
						local name = item.Name:lower()
						if targetRole == "Murderer" and (name == "knife" or name:find("couteau")) then
							return true
						elseif targetRole == "Sheriff" and (name == "gun" or name == "revolver" or name:find("pistolet")) then
							return true
						end
					end
				end
				return false
			end
			
			if checkContainer(plr.Backpack) or (char and checkContainer(char)) then
				return plr
			end
		end
	end
	return nil
end

local function findSheriffPlayer()
	return findPlayerByRole("Sheriff")
end

local function findMurdererPlayer()
	return findPlayerByRole("Murderer")
end

