local function countTotalCoinsOnMap()
	local count = 0
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local nameLower = obj.Name:lower()
			if nameLower == "coin" or nameLower == "coins" or nameLower:find("coin") or nameLower:find("piece") or nameLower:find("pièce") then
				count = count + 1
			end
		end
	end
	return count
end

local function findNearestValidCoin()
	local nearest = nil
	local shortestDist = math.huge
	local char = localPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local rootPos = char.HumanoidRootPart.Position

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Parent then
			local nameLower = obj.Name:lower()
			if nameLower == "coin" or nameLower == "coins" or nameLower:find("coin") or nameLower:find("piece") or nameLower:find("pièce") then
				if obj.Transparency < 1 and obj.Size.Magnitude > 0 then
					local dist = (obj.Position - rootPos).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						nearest = obj
					end
				end
			end
		end
	end
	return nearest
end

