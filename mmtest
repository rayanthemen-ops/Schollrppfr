RunService.RenderStepped:Connect(function(dt)
	if headCrosshair.Visible then
		headCrosshair.Rotation = headCrosshair.Rotation + (90 * dt)
	end

	if anglaisSheriffEnabled then
		local char = localPlayer.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		local backpack = localPlayer:FindFirstChild("Backpack")
		
		if char and humanoid then
			local hasGunEquipped = false
			for _, item in ipairs(char:GetChildren()) do
				if item:IsA("Tool") then
					local name = item.Name:lower()
					if name == "gun" or name == "revolver" or name:find("pistolet") then
						hasGunEquipped = true
						break
					end
				end
			end
			
			if not hasGunEquipped and backpack then
				for _, item in ipairs(backpack:GetChildren()) do
					if item:IsA("Tool") then
						local name = item.Name:lower()
						if name == "gun" or name == "revolver" or name:find("pistolet") then
							humanoid:EquipTool(item)
							break
						end
					end
				end
			end
		end
	end
	
	-- --- AUTO GRAB GUN CORRIGÉ (FLUIDE & SANS GELER LA POSITION) ---
	if autoGrabGunEnabled then
		pcall(function()
			local char = localPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
				local hrp = char.HumanoidRootPart
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				
				for _, obj in ipairs(Workspace:GetDescendants()) do
					local isGunTarget = false
					local nameLower = obj.Name:lower()
					
					if nameLower == "gun" or nameLower == "revolver" or nameLower:find("pistolet") or nameLower:find("droppedgun") or nameLower:find("sheriffgun") then
						isGunTarget = true
					end
					
					if obj:IsA("BasePart") then
						local color = obj.Color
						if color.G > 0.6 and color.R < 0.3 and color.B < 0.3 then
							isGunTarget = true
						end
					end
					
					if isGunTarget then
						local handle = nil
						if obj:IsA("Tool") then
							handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
						elseif obj:IsA("BasePart") then
							handle = obj
						end
						
						if handle and handle.Parent then
							humanoid.PlatformStand = true
							local targetCF = handle.CFrame + Vector3.new(0, 0.1, 0)
							local distance = (hrp.Position - targetCF.Position).Magnitude
							
							if distance > 0.5 then
								local alpha = math.clamp((coinTransitSpeed * dt) / math.max(distance, 0.1), 0, 1)
								hrp.CFrame = hrp.CFrame:Lerp(targetCF, alpha)
							else
								hrp.CFrame = targetCF
							end
							
							hrp.AssemblyLinearVelocity = Vector3.zero
							hrp.AssemblyAngularVelocity = Vector3.zero
							task.wait(0.02)
							humanoid.PlatformStand = false
							break
						end
					end
				end
			end
		end)
	end
	
	-- --- AIMLOCK CHIRURGICAL ULTRA-PRÉCIS ---
	local murderPlr = findMurdererPlayer()
	if murderPlr and murderPlr.Character and murderPlr.Character:FindFirstChild("Head") then
		local murderHead = murderPlr.Character.Head
		local screenPos, onScreen = Camera:WorldToViewportPoint(murderHead.Position + Vector3.new(0, 0.1, 0))
		
		if onScreen and (sheriffAimlockEnabled or sheriffSilentAimEnabled) then
			headCrosshair.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
			headCrosshair.Visible = true
			
			if sheriffAimlockEnabled then
				local targetCF = CFrame.new(Camera.CFrame.Position, murderHead.Position + Vector3.new(0, 0.15, 0))
				Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1)
			end
		else
			headCrosshair.Visible = false
		end
	else
		headCrosshair.Visible = false
	end
end)

