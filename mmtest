-- Fichier de sauvegarde pour les configurations (Auto-Save system)
local SAVE_FILE_NAME = "PrimeV2_Settings.json"

local function loadSettings()
	local success, data = pcall(function()
		if readfile and isfile and isfile(SAVE_FILE_NAME) then
			return HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
		end
	end)
	if success and type(data) == "table" then
		return data
	end
	return {}
end

local function saveSettings(data)
	pcall(function()
		if writefile then
			writefile(SAVE_FILE_NAME, HttpService:JSONEncode(data))
		end
	end)
end

