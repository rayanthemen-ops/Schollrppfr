-- Vérification de validité d'une pièce
local function isCoinValid(coin)
	if not coin or not coin.Parent or not coin:IsDescendantOf(Workspace) or coin.Transparency >= 1 or ignoredCoins[coin] then
		return false
	end
	
	local char = localPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local dist = (coin.Position - char.HumanoidRootPart.Position).Magnitude
		if dist > maxCoinDistance then
			return false
		end
	end
	
	return true
end

-- Détection de la pièce la plus proche
local function findNearestValidCoin()
	local nearest = nil
	local shortestDist = math.huge
	local char = localPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local rootPos = char.HumanoidRootPart.Position

	pcall(function()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj and obj:IsA("BasePart") and isCoinValid(obj) then
				local nameLower = obj.Name:lower()
				if nameLower == "coin" or nameLower == "coins" or nameLower:find("coin") or nameLower:find("piece") or nameLower:find("pièce") then
					if obj.Size.Magnitude > 0 then
						local dist = (obj.Position - rootPos).Magnitude
						if dist <= maxCoinDistance and dist < shortestDist then
							shortestDist = dist
							nearest = obj
						end
					end
				end
			end
		end
	end)
	return nearest
end

-- Collecte instantanée
local function simulateCollection(rootPart, coin)
	pcall(function()
		if firetouchinterest and rootPart and coin then
			firetouchinterest(rootPart, coin, 0)
			firetouchinterest(rootPart, coin, 1)
			firetouchinterest(coin, rootPart, 0)
			firetouchinterest(coin, rootPart, 1)
		end
		
		local prompt = coin:FindFirstChildWhichIsA("ProximityPrompt", true) or (coin.Parent and coin.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
		if prompt and fireproximityprompt then
			fireproximityprompt(prompt)
		end
	end)
end

-- Boucle principale d'Auto-Farm Sécurisée (5 studs sous le sol)
task.spawn(function()
	while true do
		task.wait(0.02)
		
		if autoFarmEnabled then
			pcall(function()
				local char = localPlayer.Character
				if not char then return end
				local rootPart = char:FindFirstChild("HumanoidRootPart")
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				
				if not rootPart or not humanoid or humanoid.Health <= 0 then return end
				
				local coin = findNearestValidCoin()
				
				if not coin then
					autofarmBtn.Text = "   Activer Autofarm : Attente..."
					autofarmBtn.TextColor3 = Color3.fromRGB(255, 180, 50)
					task.wait(0.1)
				else
					autofarmBtn.Text = "   Activer Autofarm : ON"
					autofarmBtn.TextColor3 = Color3.fromRGB(90, 255, 90)
					
					humanoid:ChangeState(Enum.HumanoidStateType.Physics)
					rootPart.AssemblyLinearVelocity = Vector3.zero
					rootPart.AssemblyAngularVelocity = Vector3.zero
					
					local coinPos = coin.Position
					local undergroundPos = coinPos - Vector3.new(0, 5, 0)
					local startPos = rootPart.Position
					
					-- 1. Se déplacer sous la map (à 5 studs sous la pièce)
					local distToUnder = (undergroundPos - startPos).Magnitude
					if distToUnder > 0.5 then
						local flyTime = distToUnder / math.max(autoFarmSpeed, 1)
						local elapsed = 0
						local currentStart = rootPart.Position
						while elapsed < flyTime and autoFarmEnabled and isCoinValid(coin) do
							local dt = RunService.RenderStepped:Wait()
							elapsed = elapsed + dt
							local alpha = math.min(elapsed / flyTime, 1)
							undergroundPos = coin.Position - Vector3.new(0, 5, 0)
							rootPart.CFrame = CFrame.new(currentStart:Lerp(undergroundPos, alpha))
							rootPart.AssemblyLinearVelocity = Vector3.zero
						end
					end
					
					if not isCoinValid(coin) then return end
					
					-- 2. Remonter rapidement les 5 studs pour attraper la pièce
					local upStart = rootPart.Position
					local finalCoinPos = coin.Position
					local upDist = (finalCoinPos - upStart).Magnitude
					if upDist > 0.5 then
						local flyTime = upDist / math.max(autoFarmSpeed, 1)
						local elapsed = 0
						while elapsed < flyTime and autoFarmEnabled and isCoinValid(coin) do
							local dt = RunService.RenderStepped:Wait()
							elapsed = elapsed + dt
							local alpha = math.min(elapsed / flyTime, 1)
							finalCoinPos = coin.Position
							rootPart.CFrame = CFrame.new(upStart:Lerp(finalCoinPos, alpha))
							rootPart.AssemblyLinearVelocity = Vector3.zero
						end
					end
					
					-- 3. Collecter la pièce instantanément
					if isCoinValid(coin) then
						rootPart.CFrame = CFrame.new(coin.Position)
						simulateCollection(rootPart, coin)
						
						ignoredCoins[coin] = true
						task.delay(3, function()
							ignoredCoins[coin] = nil
						end)
					end
					
					-- 4. Redescendre immédiatement de 5 studs sous le sol
					local postCollectPos = rootPart.Position
					local nextUnderground = postCollectPos - Vector3.new(0, 5, 0)
					local downDist = (nextUnderground - postCollectPos).Magnitude
					if downDist > 0.5 then
						local flyTime = downDist / math.max(autoFarmSpeed, 1)
						local elapsed = 0
						while elapsed < flyTime and autoFarmEnabled do
							local dt = RunService.RenderStepped:Wait()
							elapsed = elapsed + dt
							local alpha = math.min(elapsed / flyTime, 1)
							rootPart.CFrame = CFrame.new(postCollectPos:Lerp(nextUnderground, alpha))
							rootPart.AssemblyLinearVelocity = Vector3.zero
						end
					end
				end
			end)
		else
			pcall(function()
				local char = localPlayer.Character
				if char and char:FindFirstChildOfClass("Humanoid") then
					char:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end)
			task.wait(0.1)
		end
	end
end)
