-- =========================================================================
-- NETTOYAGE & BINDING DES BASES
-- =========================================================================

local function clearBaseListeners(base)
    if baseListeners[base] then
        for _, conn in ipairs(baseListeners[base]) do
            conn:Disconnect()
        end
        baseListeners[base] = nil
        logDebug("Listeners nettoyés pour la base :", base and base.Name or "Inconnue")
    end
end

local function bindBase(base)
    if not base then return end
    clearBaseListeners(base)
    baseListeners[base] = {}

    local connAdded = base.DescendantAdded:Connect(function(descendant)
        task.wait(0.1)
        if descendant and descendant.Parent then
            addOrUpdateBrainrot(descendant, base)
        end
    end)

    local connRemoving = base.DescendantRemoving:Connect(function(descendant)
        removeBrainrot(descendant)
    end)

    local connAttr = base:GetAttributeChangedSignal("Owner"):Connect(function()
        for inst, item in pairs(activeItems) do
            if item.Base == base then
                addOrUpdateBrainrot(inst, base)
            end
        end
    end)

    table.insert(baseListeners[base], connAdded)
    table.insert(baseListeners[base], connRemoving)
    table.insert(baseListeners[base], connAttr)

    for _, obj in ipairs(base:GetDescendants()) do
        addOrUpdateBrainrot(obj, base)
    end
end

local function scanAllBasesFull()
    logDebug("Exécution d'un Scan Total demandé...")
    
    for _, card in pairs(activeCards) do
        if card then card:Destroy() end
    end
    for k in pairs(activeCards) do activeCards[k] = nil end
    for k in pairs(activeItems) do activeItems[k] = nil end

    local basesFolder = workspace:FindFirstChild("Bases") 
        or workspace:FindFirstChild("Plots") 
        or workspace:FindFirstChild("PlayerBases")
        or workspace

    for _, base in ipairs(basesFolder:GetChildren()) do
        bindBase(base)
    end
end

