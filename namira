local function extractOwner(base)
    if not base or not base.Parent then return "Unknown" end
    local attr = base:GetAttribute("Owner") or base:GetAttribute("OwnerName") or base:GetAttribute("Player") or base:GetAttribute("BaseOwner")
    if attr and tostring(attr) ~= "" then return tostring(attr) end

    local valObj = base:FindFirstChild("Owner") or base:FindFirstChild("OwnerName") or base:FindFirstChild("BaseOwner")
    if valObj and valObj:IsA("ValueBase") and valObj.Value ~= "" then
        if valObj:IsA("ObjectValue") and valObj.Value then return valObj.Value.Name end
        return tostring(valObj.Value)
    end

    local sign = base:FindFirstChild("Sign") or base:FindFirstChild("OwnerSign") or base:FindFirstChild("PlotSign")
    if sign then
        local textLabel = sign:FindFirstChildWhichIsA("TextLabel", true)
        if textLabel and textLabel.Text ~= "" and not string.find(string.lower(textLabel.Text), "unclaimed") then
            return textLabel.Text
        end
    end

    return base.Name
end

local function extractStats(inst, bName)
    local meta = BRAINROT_META[bName]
    local statsFolder = inst:FindFirstChild("Stats") or inst:FindFirstChild("Data") or inst:FindFirstChild("Config")

    local income = inst:GetAttribute("Income")
        or inst:GetAttribute("CashPerSec")
        or inst:GetAttribute("CashRate")
        or inst:GetAttribute("MoneyPerSecond")
        or (statsFolder and statsFolder:GetAttribute("Income"))
        or (inst:FindFirstChild("Income") and inst.Income.Value)
        or (inst:FindFirstChild("CashPerSec") and inst.CashPerSec.Value)
        or (statsFolder and statsFolder:FindFirstChild("Income") and statsFolder.Income.Value)
        or (meta and meta.Income)
        or 0

    local rarity = inst:GetAttribute("Rarity")
        or inst:GetAttribute("Tier")
        or (statsFolder and statsFolder:GetAttribute("Rarity"))
        or (inst:FindFirstChild("Rarity") and inst.Rarity.Value)
        or (statsFolder and statsFolder:FindFirstChild("Rarity") and statsFolder.Rarity.Value)
        or (meta and meta.Rarity)
        or "Common"

    local cost = inst:GetAttribute("Cost")
        or inst:GetAttribute("Price")
        or (statsFolder and statsFolder:GetAttribute("Cost"))
        or (inst:FindFirstChild("Cost") and inst.Cost.Value)
        or (meta and meta.Cost)
        or 0

    local icon = meta and meta.Icon or "rbxassetid://1084991219"
    local decal = inst:FindFirstChildWhichIsA("Decal", true)
    if decal and decal.Texture ~= "" then icon = decal.Texture end

    return tonumber(income) or 0, tostring(rarity), tonumber(cost) or 0, icon
end

