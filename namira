local function updateCardLayout()
    local sortedList = {}
    for _, item in pairs(activeItems) do
        table.insert(sortedList, item)
    end

    table.sort(sortedList, function(a, b)
        return a.Income > b.Income
    end)

    for rank, item in ipairs(sortedList) do
        local card = activeCards[item.Instance]
        if card then
            card.LayoutOrder = rank
            local rankLbl = card:FindFirstChild("RankBadge", true)
            if rankLbl then
                rankLbl.Text = "#" .. tostring(rank)
                rankLbl.TextColor3 = rank == 1 and Color3.fromRGB(255, 215, 0)
                    or (rank == 2 and Color3.fromRGB(205, 205, 205) or Color3.fromRGB(150, 155, 175))
            end
        end
    end
end

local function removeBrainrot(inst)
    if activeItems[inst] then
        activeItems[inst] = nil
        if activeCards[inst] then
            activeCards[inst]:Destroy()
            activeCards[inst] = nil
        end
        updateCardLayout()
        logDebug("Suppression Brainrot :", inst and inst.Name or "Inconnu")
    end
end

