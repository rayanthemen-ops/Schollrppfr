local function exportData(format)
    local exportList = {}
    for _, item in pairs(activeItems) do
        table.insert(exportList, {
            BaseName = item.Base.Name,
            Owner = item.Owner,
            Brainrot = item.Name,
            Rarity = item.Rarity,
            Cost = item.Cost,
            Income = item.Income,
            Icon = item.Icon
        })
    end

    table.sort(exportList, function(a, b) return a.Income > b.Income end)

    local outputStr = ""
    if format == "json" then
        outputStr = HttpService:JSONEncode(exportList)
    else
        outputStr = "Rank,BaseName,Owner,Brainrot,Rarity,Cost,Income,Icon\n"
        for rank, row in ipairs(exportList) do
            outputStr = outputStr .. string.format(
                "%d,\"%s\",\"%s\",\"%s\",\"%s\",%d,%d,\"%s\"\n",
                rank, row.BaseName, row.Owner, row.Brainrot, row.Rarity, row.Cost, row.Income, row.Icon
            )
        end
    end

    local clipFunc = setclipboard or toclipboard or (Clipboard and Clipboard.set)
    if clipFunc then
        clipFunc(outputStr)
        logDebug("Exportation réussie et copiée dans le presse-papier (" .. format:upper() .. ")")
    else
        print("=== EXPORT RESULT (" .. format:upper() .. ") ===")
        print(outputStr)
        print("==============================================")
    end
end

